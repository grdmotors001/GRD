# Supabase PostgreSQL connection string.
# Use the Transaction Pooler URL from Supabase for Vercel/serverless workloads.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Required for Flask sessions. Generate a long random value.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional. Used only when the database has no users yet.
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY
